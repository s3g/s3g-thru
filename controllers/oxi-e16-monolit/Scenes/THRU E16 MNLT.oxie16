{"title":"THRU EM","icon":[0,0,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,102,0,0],"selectedPreset":0,"color":0,"transmitMode":0,"pcOnEntry":0,"bankOnEntry":65535,"recentPage":0,"recentPreset":0,"transmitOnSceneEntry":0,"transmitOnPageSwitch":0,"transmitOnPresetLoad":0,"smartTransmit":15,"outputOnEntry":0,"holdMode":0,"acceleration":0,"code":{"code":"local seq=0\nlocal function request()\nseq=seq%127+1\nmidi.sendCC(3,13,125,seq)\nmidi.sendCC(3,13,126,controller.getPage())\nend\nlocal function clear()\nfor i=1,16 do leds.updateByIndex(i,0,0) end\nend\nfunction page.onInit()\nclear()\nsystem.setUpdateRate(1000)\nrequest()\nend\nfunction page.onPageChange(prev,curr)\nclear()\nrequest()\nend\nfunction system.update()\nrequest()\nend\nfunction controller.onSysex(b)\nif #b<8 or (#b-8)%4~=0 or b[1]~=240 or b[#b]~=247\nor b[2]~=125 or b[3]~=83 or b[4]~=84 or b[5]~=1\nor b[6]~=controller.getPage()-1 or b[7]~=seq then return end\nfor i=2,#b-1 do\nif type(b[i])~=\"number\" or b[i]<0 or b[i]>127 then return end\nend\nfor i=8,#b-1,4 do\nlocal index=b[i]+1\nif index>=1 and index<=16 and b[i+3]<=100 then\nleds.updateByIndex(index,b[i+1]*128+b[i+2],b[i+3])\nend\nend\nend","fullScript":"-- Feedback only. Native CC Rel1 turns and default pushes remain in firmware.\n-- No sound values, parameter tables, or encoder callbacks are stored here.\nlocal seq=0\nlocal function request()\n  seq=seq%127+1\n  midi.sendCC(3,13,125,seq)\n  midi.sendCC(3,13,126,controller.getPage())\nend\nlocal function clear()\n  for i=1,16 do leds.updateByIndex(i,0,0) end\nend\nfunction page.onInit()\n  clear()\n  system.setUpdateRate(1000)\n  request()\nend\nfunction page.onPageChange(prev,curr)\n  clear()\n  request()\nend\nfunction system.update()\n  -- Refresh also discovers Thru when it is opened after the scene.\n  request()\nend\nfunction controller.onSysex(b)\n  if #b<8 or (#b-8)%4~=0 or b[1]~=240 or b[#b]~=247\n      or b[2]~=125 or b[3]~=83 or b[4]~=84 or b[5]~=1\n      or b[6]~=controller.getPage()-1 or b[7]~=seq then return end\n  for i=2,#b-1 do\n    if type(b[i])~=\"number\" or b[i]<0 or b[i]>127 then return end\n  end\n  for i=8,#b-1,4 do\n    local index=b[i]+1\n    if index>=1 and index<=16 and b[i+3]<=100 then\n      leds.updateByIndex(index,b[i+1]*128+b[i+2],b[i+3])\n    end\n  end\nend\n","scriptName":"Thru Rings"},"pages":[{"title":"ENGINE","output":3,"channel":1,"encoders":[{"name":"ALG","abbr":"ALG","color":30,"color2":0,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":0,"channel":14,"lower":0,"upper":1,"nr1":127,"nr2":1,"output":12,"scriptId":0,"defaultValue":0},"turn_actions":[{"instrument":127,"parameter":0,"type":1,"display":0,"mode":3,"channel":14,"lower":0,"upper":127,"nr1":0,"nr2":0,"output":12,"scriptId":0,"defaultValue":0},{"instrument":127,"parameter":0,"type":0,"display":0,"mode":0,"channel":0,"lower":0,"upper":127,"nr1":0,"nr2":0,"output":12,"scriptId":0,"defaultValue":0}]},{"name":"POS","abbr":"POS","color":30,"color2":0,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":0,"channel":14,"lower":0,"upper":2,"nr1":127,"nr2":2,"output":12,"scriptId":0,"defaultValue":0},"turn_actions":[{"instrument":127,"parameter":0,"type":1,"display":0,"mode":3,"channel":14,"lower":0,"upper":127,"nr1":1,"nr2":0,"output":12,"scriptId":0,"defaultValue":0},{"instrument":127,"parameter":0,"type":0,"display":0,"mode":0,"channel":0,"lower":0,"upper":127,"nr1":0,"nr2":0,"output":12,"scriptId":0,"defaultValue":0}]},{"name":"FLD","abbr":"FLD","color":30,"color2":0,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":0,"channel":14,"lower":0,"upper":3,"nr1":127,"nr2":3,"output":12,"scriptId":0,"defaultValue":0},"turn_actions":[{"instrument":127,"parameter":0,"type":1,"display":0,"mode":3,"channel":14,"lower":0,"upper":127,"nr1":2,"nr2":0,"output":12,"scriptId":0,"defaultValue":0},{"instrument":127,"parameter":0,"type":0,"display":0,"mod