{
  "name": "s3g-thru",
  "version": "0.30.0-test.39",
  "private": true,
  "type": "module",
  "description": "s3g Thru takeover sampler for Ableton Move and Schwung.",
  "scripts": {
    "test": "bash scripts/test-native.sh",
    "validate": "bash scripts/validate-native.sh",
    "release:check": "node scripts/validate-release.mjs",
    "help:check": "node scripts/validate-help.mjs",
    "docs:render": "node scripts/render-doc-screens.mjs",
    "docs:check": "node scripts/render-doc-screens.mjs --check && node scripts/check-docs.mjs",
    "docs:serve": "python3 -m http.server 8080 --directory docs",
    "build:native": "bash scripts/build-native.sh",
    "build": "bash scripts/package-native.sh",
    "package:verify": "bash scripts/verify-package.sh",
    "export:set": "bash scripts/export-set.sh",
    "controllers:generate": "node controllers/oxi-e16/generate-layout.mjs && node controllers/oxi-e16/generate-remote-scene.mjs && node controllers/oxi-e16-nrpn/generate-scene.mjs",
    "controllers:check": "node controllers/oxi-e16/generate-layout.mjs --check && node controllers/oxi-e16/generate-remote-scene.mjs --check && node controllers/oxi-e16-nrpn/generate-scene.mjs --check && node controllers/lightreft-monolit/generate-preset.mjs --validate controllers/lightreft-monolit/presets/s3g-thru",
    "midi:generate": "node scripts/generate-midi.mjs && node scripts/generate-midi-ui.mjs",
    "midi:check": "node scripts/generate-midi.mjs --check && node scripts/generate-midi-ui.mjs --check",
    "test:e16": "node tests/test_e16.mjs && node tests/test_e16_remote.mjs && node tests/test_e16_nrpn.mjs",
    "controllers:package": "bash scripts/package-e16.sh",
    "controllers:remote:package": "bash scripts/package-e16.sh",
    "controllers:nrpn:package": "bash scripts/package-e16-nrpn.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
