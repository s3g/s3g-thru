        {
          "title": "Full manual",
          "lines": [
            "Illustrated manual:",
            "",
            "s3g.github.io/",
            "s3g-thru/",
            "",
            "Complete engine",
            "parameters, diagrams",
            "and the MIDI map."
          ]
        }
      ]
    },
    {
      "title": "Legato and Bank",
      "children": [
        {
          "title": "Legato keys",
          "lines": [
            "Pads & Scale: VOICE.",
            "Poly: separate voices.",
            "Mono: one retriggered",
            "voice. Legato: overlap",
            "keys to change pitch",
            "without restarting.",
            "",
            "Newest key wins.",
            "Release to return to",
            "the prior held key.",
            "Release all for the",
            "envelope release.",
            "Engine assignment is",
            "kept for the phrase."
          ]
        },
        {
          "title": "Gain compensation",
          "lines": [
            "Former POLY control:",
            "Capture + Menu, Voice,",
            "Play Gain, COMP.",
