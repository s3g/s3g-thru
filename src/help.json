        },
        {
          "title": "Leave and save",
          "lines": [
            "Back closes a",
            "secondary view. From",
            "the main waveform,",
            "Back saves and exits",
            "takeover. Let pending",
            "saving finish before",
            "powering off.",
            "",
            "For this help, leave",
            "takeover and open",
            "Schwung Global",
            "Settings, System,",
            "Help, Modules, s3g",
            "Thru."
