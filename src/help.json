            "on Pads & Scale is",
            "Poly / Mono / Legato."
          ]
        },
        {
          "title": "Bank capture",
          "lines": [
            "Select Bank in Mode.",
            "Left: A, four lanes.",
            "Right: 16 sample pads.",
            "",
            "SRC on Bank Pads:",
            "IN, MIX, PT A, PT B.",
            "PT B records Bank.",
            "Hold empty pad: rec.",
            "Min take: 250 ms.",
            "Silent takes ignored.",
            "Keep initial attack.",
            "Release: save silently.",
            "Max 12 seconds each.",
            "Source held per take."
          ]
        },
        {
          "title": "Bank playback",
          "lines": [
            "Filled pad: PLAY LOOP",
            "while held or latched.",
            "ONE plays once.",
            "Shift + pad: latch.",
            "X + pad: clear.",
            "Undo restores slot.",
            "",
            "Bank Pads: ratio, pan,",
            "play and choke group.",
            "RATE is bank master.",
            "RATIO scales RATE."
          ]
        },
        {
          "title": "Bank recall",
          "lines": [
            "Stereo takes saved",
            "in Thru Recordings.",
            "Each clip retains its",
            "Bank slot assignments.",
