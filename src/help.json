            "Knob 2: start.",
            "Knob 3: end.",
            "Knob 4: zoom.",
            "Knob 5: pre-roll.",
            "Shift: 0.1 ms fine.",
            "",
            "Pads audition slices.",
            "Shift + pad latches.",
            "Loop: repeat audition.",
            "Up/Down: pad bank.",
            "Main turn: cursor.",
            "Main click: add cut.",
            "X: merge at cut.",
            "Curved Undo: undo.",
            "Back: return."
