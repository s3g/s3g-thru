 voice.reset();for(int n=0;n<30000;++n)voice.tick(p.patches,0,110,44100);double late=0;for(int n=0;n<3000;++n){auto a=voice.tick(p.patches,3,110,44100);late+=a[0]*a[0];}assert(late<1e-8);
 for(float sr:{44100.f,48000.f,96000.f}){voice.reset();for(auto& c:p.patches)c={};for(int n=0;n<18000;++n){if(n%128==0){const int field=n/128%f::fields;for(auto& c:p.patches)c.v[field]=(n/256)%2?f::low[field]:f::high[field];voice.beginBlock(p.patches);}auto a=voice.tick(p.patches,1.5f+1.49f*std::sin(n*.001f),55+n*.2f,sr);for(float x:a)assert(std::isfinite(x)&&std::abs(x)<8);}}
