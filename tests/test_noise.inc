void testNoiseCore(){namespace n=s3g_thru_noise;n::Instrument voice;voice.prepare();
 for(float sr:{44100.f,48000.f,96000.f})for(int kind=0;kind<7;++kind){n::Program p;for(auto& c:p.patches){c={};c.v[n::type]=kind;c.v[n::width]=0;c.v[n::rate]=100;}voice.reset();double energy=0;for(int f=0;f<16000;++f){if(f%128==0)voice.beginBlock(p.patches);const auto out=voice.tick(p.patches,1.5f,220,sr);assert(out[0]==out[1]);for(float x:out){assert(std::isfinite(x)&&std::abs(x)<4);energy+=x*x;}}assert(energy>.001);}
 // Narrow single bands track the note; stack entry and live edits stay finite.
 for(float pitch:{110.f,220.f,440.f}){n::Program p;for(auto& c:p.patches){c={};c.v[n::count]=1;c.v[n::bandwidth]=.1f;c.v[n::width]=0;}voice.reset();std::array<float,20000> audio{};for(int f=0;f<24000;++f){if(f%128==0)voice.beginBlock(p.patches);auto out=voice.tick(p.patches,0,pitch,44100);if(f>=4000)audio[f-4000]=out[0];}const auto power=[&](float hz){double re=0,im=0;for(int i=0;i<int(audio.size());++i){const double phase=6.283185307179586*hz*i/44100;re+=audio[i]*std::cos(phase);im+=audio[i]*std::sin(phase);}return re*re+im*im;};assert(power(pitch)>4*std::max(power(pitch*.5f),power(pitch*2)));}

 n::Program p;voice.reset();for(int f=0;f<60000;++f){if(f%128==0){int field=f/128%n::fields;for(auto& c:p.patches)n::set(c,field,(f/128)%2?n::low[field]:n::high[field]);voice.beginBlock(p.patches);}auto out=voice.tick(p.patches,1.5f+1.49f*std::sin(f*.001f),110+f*.03f,44100);for(float x:out)assert(std::isfinite(x)&&std::abs(x)<8);}
 n::Config c;c.v[n::style]=1;assert(n::resolved(c,n::ratios+3)==7);n::set(c,n::ratios+3,7.25f);assert(c.v[n::style]==3&&c.v[n::ratios+2]==5&&c.v[n::ratios+3]==7.25f);
 std::puts("NOISE core: seven types/three rates, keyboard tuning, exact mono, finite live extremes, scan, stable component grids and bounded event overlap: PASS");
}
