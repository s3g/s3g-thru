 assert(t->exportProjectFile());const auto target=std::string(folder)+"/restored";std::filesystem::create_directory(target);restored.reset();restored=std::make_unique<ThruInstance>();assert(restored->prepare(target.c_str()));restored->stopBackgroundWork();assert(restored->savePersistentState());restored->projectGeneration=restored->reservePersistenceGeneration();std::snprintf(restored->projectArchivePath.data(),restored->projectArchivePath.size(),"%s",t->projectOutputPath.data());assert(restored->importProjectFile()&&restored->savePersistentState());restored.reset();restored=std::make_unique<ThruInstance>();assert(restored->prepare(target.c_str()));restored->stopBackgroundWork();assert(restored->controls.algorithm==Engine::PlaybackAlgorithm::noise&&restored->controls.noise.patches[0].v[n::ratios+31]==39.5f&&restored->controls.noise.patches[0].v[n::bandwidth]==7);
 restored.reset();t->persistenceEnabled=false;t.reset();std::filesystem::remove_all(folder);std::puts("NOISE storage: format57/JSON, all 32 bands, captured gestures and real portable export/import/restart: PASS");
